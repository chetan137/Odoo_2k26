// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Fleet Management Auth System
// Roles: ADMIN, MANAGER, DISPATCHER  |  Drivers: separate entity
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── System User Enums ────────────────────────────────────────────────────────
enum Role {
  ADMIN
  MANAGER
  DISPATCHER
}

// ─── Trip Status Enum ───────────────────────────────────────────────────────
enum TripStatus {
  PENDING
  ON_TRIP
  COMPLETED
  CANCELLED
}

// ─── Driver Enums ─────────────────────────────────────────────────────────────
enum DriverStatus {
  AVAILABLE
  ON_TRIP
  INACTIVE
}

enum VehicleCategory {
  BIKE
  LIGHT
  MEDIUM
  HEAVY
  EXTRA_HEAVY
  CONTAINER
}

// ─── Vehicle Status Enum ─────────────────────────────────────────────────────
enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
}

// ─── System Users (ADMIN / MANAGER / DISPATCHER) ─────────────────────────────
model User {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @unique @map("employee_id")
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255)
  role       Role     @default(DISPATCHER)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

// ─── Vehicles ─────────────────────────────────────────────────────────────────
model Vehicle {
  id                String          @id @default(uuid()) @db.Uuid
  vehicleId         String          @unique @map("vehicle_id")      // VHL-0001 …
  vehicleName       String          @map("vehicle_name") @db.VarChar(150)
  licensePlate      String          @unique @map("license_plate") @db.VarChar(20)
  category          VehicleCategory
  maxCapacity       Int             @map("max_capacity")             // kg
  currentOdometer   Int             @default(0) @map("current_odometer") // km
  status            VehicleStatus   @default(AVAILABLE)
  acquisitionCost   Decimal         @map("acquisition_cost") @db.Decimal(12, 2)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  trips             Trip[]

  @@index([category])
  @@index([status])
  @@map("vehicles")
}

// ─── Drivers (completely separate entity) ─────────────────────────────────────
model Driver {
  id                String          @id @default(uuid()) @db.Uuid
  driverId          String          @unique @map("driver_id")          // DRV-0001 …
  name              String          @db.VarChar(100)
  email             String          @unique @db.VarChar(255)
  password          String          @db.VarChar(255)
  phoneNumber       String          @map("phone_number") @db.VarChar(15)
  licenseNumber     String          @unique @map("license_number") @db.VarChar(50)
  licenseExpiryDate DateTime        @map("license_expiry_date") @db.Date
  vehicleCategory   VehicleCategory @default(LIGHT) @map("vehicle_category")
  yearsOfExperience Int             @default(0) @map("years_of_experience")
  licensePhotoUrl   String?         @map("license_photo_url") @db.Text
  status            DriverStatus    @default(AVAILABLE)
  isApproved        Boolean         @default(false) @map("is_approved")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  trips             Trip[]

  @@index([email])
  @@index([licenseNumber])
  @@index([status])
  @@index([isApproved])
  @@map("drivers")
}

// ─── Trips ───────────────────────────────────────────────────────────────────
model Trip {
  id          String      @id @default(uuid()) @db.Uuid
  tripId      String      @unique @map("trip_id")       // TRP-0001...
  origin      String      @db.VarChar(255)
  destination String      @db.VarChar(255)
  status      TripStatus  @default(PENDING)
  driverId    String      @map("driver_id") @db.Uuid
  driver      Driver      @relation(fields: [driverId], references: [id])
  vehicleId   String?     @map("vehicle_id") @db.Uuid
  vehicle     Vehicle?    @relation(fields: [vehicleId], references: [id])
  startTime   DateTime?   @map("start_time") @db.Timestamptz
  endTime     DateTime?   @map("end_time") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tripId])
  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
  @@map("trips")
}
